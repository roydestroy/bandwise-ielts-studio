{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bandwise-ielts-studio",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true},
  "routes": [{"pattern": "bandwise.eurognosi-remote.com", "custom_domain": true}],
  "assets": {"not_found_handling": "none"},
  "d1_databases": [{"binding":"DB","database_name":"bandwise","database_id":"00000000-0000-4000-8000-000000000000","migrations_dir":"drizzle"}],
  "r2_buckets": [{"binding":"BUCKET","bucket_name":"bandwise-uploads"}],
  "vars": {"ACCESS_TEAM_DOMAIN":"","ACCESS_AUD":""}
}
